        ],
        "description": "Relaunch a worker with a reviewed serving profile (model, parser, chat template, flags and limits). Repairs a worker whose configuration differs from the reviewed one. Takes the worker out of rotation while it restarts.",
        "id": "apply-serving-profile",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "profile": {
              "enum": [
                "qwen25-coder-7b.tools-template"
              ],
              "type": "string"
            }
          },
          "required": [
            "profile"
          ],
          "type": "object"
        },
        "removes_capacity": true,
        "requires_rollback": true,
        "restores_service": true
      },
      {
        "addresses": [
          "network_path",
          "overloaded"
        ],
        "allowed_targets": [
          "target-a",
          "target-b"
        ],
        "automatic": true,
        "before_state_keys": [
          "container_state",
          "tool_call_parser"
        ],
        "description": "Stop routing new traffic to a worker. Mitigates a fault that software cannot repair (the path to the worker, or load it cannot carry); the cause still needs a human. Refused if no other worker is serving.",
        "id": "drain-worker",
        "parameters": {
          "additionalProperties": false,
          "properties": {},
          "type": "object"
        },
        "removes_capacity": true,
        "requires_rollback": true,
        "restores_service": false
      },
