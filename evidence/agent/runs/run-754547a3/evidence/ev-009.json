          "target-a",
          "target-b"
        ],
        "automatic": true,
        "before_state_keys": [
          "container_state",
          "tool_call_parser"
        ],
        "description": "Relaunch a worker with its current profile. Repairs a crashed or hung worker; does not change its configuration. Takes the worker out of rotation while it restarts.",
        "id": "restart-worker",
        "parameters": {
          "additionalProperties": false,
          "properties": {},
          "type": "object"
        },
        "removes_capacity": true,
        "requires_rollback": true,
        "restores_service": true
      },
