# Copy to .env and fill in. Never commit .env.
HF_TOKEN=                       # Hugging Face read token
HF_HOME=/home/ubuntu/.cache/huggingface
NEXUS_VLLM_IMAGE=vllm/vllm-openai:v0.27.1
# Red Hat AI Inference image (if registry access works); pin the digest once pulled
# NEXUS_VLLM_IMAGE=registry.redhat.io/rhaii/vllm-cuda-rhel9:3.5.1
NEXUS_NETWORK=nexus
NEXUS_WORKERS=a=http://nexus-a:8000,b=http://toxiproxy:8666
NEXUS_MAX_INFLIGHT=0              # gateway admission cap; 0 = off
NEXUS_ADMIN_TOKEN=                # bearer token for gateway /admin/*; generate with: openssl rand -hex 16

# Box operator app (apps/operator, scripts/operator_up.sh): run records + "Break it".
NEXUS_OPERATOR_TOKEN=             # created by operator_up.sh; the UI server holds it, never the browser or the agent

# UI server (apps/twin) live mode. Point these at the SSH-forwarded box ports (web/README.md).
NEXUS_OPERATOR_URL=               # e.g. http://127.0.0.1:8130; unset = results from local evidence/, no Break it
NEXUS_GATEWAY_URL=http://127.0.0.1:8110
NEXUS_PROMETHEUS_URL=http://127.0.0.1:9090
ARTIFACTS_DIR=                    # optional local mirror of the box's artifacts/ (read before evidence/)

# Agent (Nemotron 3.5 Lightning on vLLM; any OpenAI-compatible endpoint works).
NEMOTRON_BASE_URL=http://127.0.0.1:8103/v1   # nexus-agent container on the box (docs/brev.md)
NEMOTRON_MODEL=nemotron-lightning           # served model name; required
NEMOTRON_API_KEY=                           # only for hosted endpoints
NEMOTRON_TIMEOUT_SECONDS=30                 # per model call
NEMOTRON_TEMPERATURE=0                      # 0 is the evaluated default (0.6 ablation: same total)
NEXUS_AGENT_STRUCTURED=1                    # 1 = redesigned harness (default); 0 = old free-form agent
# NEXUS_RUN_TIMEOUT_SECONDS=300            # per-run cap; unset = 150 s structured, 120 s free-form (300 for the hosted Super run)

# Agent's environment API (apps/environment, scripts/environment_up.sh creates the two secrets).
NEXUS_ENVIRONMENT_URL=http://127.0.0.1:8120
NEXUS_ENVIRONMENT_API_KEY=                  # agent reads
NEXUS_EXECUTOR_TOKEN=                       # runner applies actions; never given to the model
