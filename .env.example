# Copy to .env on the GPU box and fill in. Never commit .env.
# scripts/environment_up.sh and scripts/operator_up.sh add their own tokens to .env on first run.

# ---- Fleet (GPU box) ------------------------------------------------------------------------------
HF_TOKEN=                         # Hugging Face read token (model downloads)
HF_HOME=/home/ubuntu/.cache/huggingface   # model cache; set for your host (the Brev box uses /ephemeral/hf)
NEXUS_VLLM_IMAGE=vllm/vllm-openai:v0.27.1
NEXUS_NETWORK=nexus
NEXUS_WORKERS=a=http://nexus-a:8000,b=http://toxiproxy:8666
NEXUS_MAX_INFLIGHT=0              # gateway admission cap; 0 = off
NEXUS_ADMIN_TOKEN=                # bearer token for the gateway admin API; generate with: openssl rand -hex 16
# NEXUS_GATEWAY_URL is not set here: on the box it means the HAProxy inference entry point and defaults to :8100.

# ---- Agent (Nemotron 3.5 Lightning on vLLM; any OpenAI-compatible endpoint works) -----------------
NEMOTRON_BASE_URL=http://127.0.0.1:8103/v1   # nexus-agent container on the box (docs/brev.md)
NEMOTRON_MODEL=nemotron-lightning           # served model name; required
NEMOTRON_API_KEY=                           # only for hosted endpoints
NEMOTRON_TIMEOUT_SECONDS=30                 # per model call
NEMOTRON_TEMPERATURE=0                      # 0 is the evaluated default (0.6 ablation: same total)
NEXUS_AGENT_STRUCTURED=1                    # 1 = redesigned harness (default); 0 = old free-form agent
# NEXUS_RUN_TIMEOUT_SECONDS=300            # per-run cap; unset = 150 s structured, 120 s free-form (300 for the hosted Super run)

# ---- Agent's environment API and executor (scripts/environment_up.sh creates the two secrets) ------
NEXUS_ENVIRONMENT_URL=http://127.0.0.1:8120
NEXUS_ENVIRONMENT_API_KEY=                  # agent reads
NEXUS_EXECUTOR_TOKEN=                       # runner applies actions; never given to the model

# ---- Operator app (scripts/operator_up.sh creates the token) --------------------------------------
NEXUS_OPERATOR_TOKEN=             # run records + named faults ("Break it live"); the UI server holds it, never the browser or the agent

# ---- Laptop only: UI server (scripts/twin.sh) in live mode, over an SSH tunnel to the box ----------
# Export these in the laptop shell; don't put them in the box .env, where NEXUS_GATEWAY_URL means
# the inference entry point. Unset NEXUS_OPERATOR_URL = results from the local evidence/, no Break it.
# NEXUS_OPERATOR_URL=http://127.0.0.1:8130
# NEXUS_OPERATOR_TOKEN=<from the box .env>
# NEXUS_GATEWAY_URL=http://127.0.0.1:8110    # gateway admin API (the UI server reads worker state from it)
# NEXUS_ADMIN_TOKEN=<from the box .env>
# NEXUS_PROMETHEUS_URL=http://127.0.0.1:9090
# ARTIFACTS_DIR=                            # optional local mirror of the box's artifacts/
