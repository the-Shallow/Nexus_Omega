{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-omega.local/schemas/agent-decision.schema.json",
  "title": "Nexus Omega agent decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "summary", "hypotheses", "stop_reason"],
  "properties": {
    "state": {
      "enum": [
        "INGEST",
        "DIAGNOSE",
        "EXPAND_CONTEXT",
        "PLAN",
        "PRECHECK",
        "ACT",
        "VERIFY",
        "VERIFIED",
        "ROLLED_BACK",
        "REQUIRES_APPROVAL",
        "ABSTAIN"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "confidence", "supports", "contradicts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "supports": {"type": "array", "items": {"type": "string"}},
          "contradicts": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "stop_reason": {
      "type": ["string", "null"]
    },
    "repair_plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "confidence",
        "evidence",
        "action",
        "expected_effect",
        "risk",
        "verification_plan",
        "rollback_plan"
      ],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "arguments"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "arguments": {"type": "object"}
          }
        },
        "expected_effect": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "verification_plan": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "rollback_plan": {"type": "string", "minLength": 1}
      }
    }
  }
}
